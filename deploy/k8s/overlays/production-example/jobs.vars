# Job defaults for the production example, read by deploy/k8s/jobs/render.sh (KEY=value; an
# environment variable of the same name wins). Workers are sized per worker, never per input:
# memory is the per-task settings (PI_TASK_MEMORY_BYTES, PI_BUFFER_BYTES, segment size, in
# config-patch.yaml) times WORKER_CONCURRENCY. A bigger input
# takes more workers (and partitions); load pressure on the data nodes is
# WORKERS x PI_SENDERS_PER_WORKER (see kustomization.yaml).

# A released image from a registry, pinned by tag (or by digest: name@sha256:...).
IMAGE=ghcr.io/cristiangirlea/people-index:0.1.0
IMAGE_PULL_POLICY=IfNotPresent

WORKERS=12
WORKER_BACKOFF_LIMIT=24
WORKER_CONCURRENCY=2
WORKER_CPU=2
WORKER_MEMORY=4Gi
COORDINATOR_CONCURRENCY=4
COORDINATOR_CPU=1
COORDINATOR_MEMORY=2Gi
RUN_DEADLINE_SECONDS=43200
TMP_SIZE=8Gi

PERSONS=10000000
ORGANIZATIONS=2000000
FILES=64
SEED=42
DATAGEN_CPU=2
DATAGEN_MEMORY=2Gi
DATAGEN_DEADLINE_SECONDS=14400
