# Job defaults for the local k3d cluster, read by deploy/k8s/jobs/render.sh (KEY=value; an
# environment variable of the same name wins). Sized to fit beside the local Elasticsearch on
# a laptop: three workers, one per zone.

# The image built from the repository's Dockerfile and loaded with
# `k3d image import people-index:local -c people-index`; Never, because there is no registry.
IMAGE=people-index:local
IMAGE_PULL_POLICY=Never

WORKERS=3
WORKER_BACKOFF_LIMIT=10
WORKER_CONCURRENCY=2
WORKER_CPU=500m
WORKER_MEMORY=1Gi
COORDINATOR_CONCURRENCY=2
COORDINATOR_CPU=250m
COORDINATOR_MEMORY=512Mi
RUN_DEADLINE_SECONDS=7200
TMP_SIZE=2Gi

PERSONS=200000
ORGANIZATIONS=50000
FILES=8
SEED=42
DATAGEN_CPU=500m
DATAGEN_MEMORY=512Mi
DATAGEN_DEADLINE_SECONDS=3600
