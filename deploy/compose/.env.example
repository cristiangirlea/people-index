# Copy to deploy/compose/.env (git-ignored) and change the passwords. Every name here has a
# development default in compose.yaml; set only what you want to change.

# Credentials. The defaults are for a local stack whose ports bind to 127.0.0.1 only.
ELASTIC_PASSWORD=change-me-elastic
PIPELINE_ES_PASSWORD=change-me-pipeline
S3_ACCESS_KEY_ID=people-index-dev
S3_SECRET_ACCESS_KEY=change-me-s3-secret

# Published ports (always on 127.0.0.1).
ES_PORT=9200
S3_PORT=8333
PROMETHEUS_PORT=9090

# Elasticsearch: heap per node and the container limit (keep the heap at half the limit or less).
ES_HEAP=512m
ES_MEM_LIMIT=1g
# Set to false on a nearly full disk, where watermarks would keep shards unassigned.
ES_DISK_THRESHOLD_ENABLED=true

# Workers: replicas, tasks at once per worker, and the limits of each container.
WORKERS=3
WORKER_CONCURRENCY=2
WORKER_CPUS=2
WORKER_MEMORY=2g
COORDINATOR_CPUS=1
COORDINATOR_MEMORY=1g

# Pipeline knobs (docs/ARCHITECTURE.md, Configuration).
PI_ALIAS=persons
PI_LEASE_TTL=60s
PI_PARTITION_TARGET_BYTES=268435456
PI_MIN_PARTITIONS=16
PI_BULK_MAX_BYTES=8388608
PI_SENDERS_PER_WORKER=2
PI_MAX_MALFORMED=1000
# Per-task memory; keep the sum (task + buffer + 8 x segment + 32MiB) under
# WORKER_MEMORY / WORKER_CONCURRENCY and COORDINATOR_MEMORY (docs/OPERATIONS.md, Sizing).
PI_TASK_MEMORY_BYTES=384MiB
PI_BUFFER_BYTES=128MiB
PI_SEGMENT_TARGET_BYTES=32MiB
PI_LOG_FORMAT=json
RUST_LOG=info

# Synthetic data (profile datagen).
DATAGEN_PERSONS=200000
DATAGEN_ORGANIZATIONS=50000
DATAGEN_FILES=8
DATAGEN_SEED=42
DATAGEN_CPUS=2
DATAGEN_MEMORY=1g

# Where verify reads the expected counts.
VERIFY_EXPECTED=s3://people-index/raw/expected.json
# What verify checks against: expected (the file above) or summary (a run's summary.json, for
# real feeds); VERIFY_RUN_ID picks the run, by default the one the alias serves.
# VERIFY_SOURCE=expected
# VERIFY_RUN_ID=
